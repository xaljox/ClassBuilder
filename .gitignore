# Build output (CMake / Ninja / VS) -- regenerable
/out/
build/
[Dd]ebug/
[Rr]elease/

# Installer output (Inno Setup ClassBuilderSetup.exe) -- regenerable from the .iss
/installer/output/

# Visual Studio / VS Code local state
.vs/
*.user
*.suo
*.VC.db
*.VC.opendb

# Compiler / linker intermediates (sources & prebuilt zstd libs ARE tracked)
*.obj
*.ilk
*.pdb
*.tlog
*.idb
*.exp
*.aps

# OS cruft
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# Editor backups / model autosave backups
*~
*.bak
~*.CBZ
~*.cbz
*.~*CBZ
*.~*cbz

# Local-only CMake presets (personal Qt prefix etc.)
CMakeUserPresets.json

# Per-machine Claude Code permissions (keep out of the cross-platform sync)
.claude/settings.local.json

# Generated source emitted next to the throwaway test model (models/test/Matrix.CBZ)
models/test/*.cpp
models/test/*.h
~$*
